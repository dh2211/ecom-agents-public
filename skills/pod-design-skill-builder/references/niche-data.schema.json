{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/schemas/pod-niche-data-3.2.json",
  "title": "POD Niche Master Data 3.2",
  "type": "object",
  "required": [
    "schema_version",
    "niche_slug",
    "niche_display",
    "locale",
    "niche_profile",
    "data_provenance",
    "personas",
    "buyer_recipient_pairs",
    "occasions",
    "emotions",
    "buyer_language",
    "visual_vocabulary",
    "product_fit",
    "personalization_fields",
    "hook_patterns",
    "style_variants",
    "concept_fit_calibration",
    "ip_safety",
    "output_profiles",
    "output_defaults",
    "qa_rules",
    "sample_briefs",
    "market_contexts",
    "evidence_claims",
    "production_methods",
    "idea_archetypes",
    "creative_controls",
    "combination_rules",
    "sensitivity_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "3.2"
    },
    "niche_slug": {
      "$ref": "#/$defs/id"
    },
    "niche_display": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "not": {"pattern": "\\s"}
    },
    "niche_profile": {
      "type": "object",
      "required": [
        "audience_summary",
        "primary_buyers",
        "primary_recipients",
        "identity_signals",
        "niche_boundaries",
        "excluded_segments"
      ],
      "properties": {
        "audience_summary": {
          "type": "string",
          "minLength": 1
        },
        "primary_buyers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "identity_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "niche_boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_segments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "data_provenance": {
      "type": "object",
      "required": [
        "evidence_status",
        "legal_status",
        "last_updated",
        "marketplaces",
        "sources",
        "assumptions"
      ],
      "properties": {
        "evidence_status": {
          "enum": [
            "curated-draft",
            "researched",
            "validated"
          ]
        },
        "legal_status": {
          "enum": [
            "unchecked",
            "screened-not-cleared",
            "human-review-required"
          ]
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "marketplaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_owner": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reviewed_at": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": true
    },
    "personas": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/persona"
      }
    },
    "buyer_recipient_pairs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/pair"
      }
    },
    "occasions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/occasion"
      }
    },
    "emotions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/emotion"
      }
    },
    "buyer_language": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/buyerLanguage"
      }
    },
    "visual_vocabulary": {
      "type": "object",
      "required": [
        "motifs",
        "palettes",
        "typography",
        "compositions"
      ],
      "properties": {
        "motifs": {
          "type": "array",
          "minItems": 6,
          "items": {
            "$ref": "#/$defs/motif"
          }
        },
        "palettes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/palette"
          }
        },
        "typography": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/typography"
          }
        },
        "compositions": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/composition"
          }
        }
      },
      "additionalProperties": true
    },
    "product_fit": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "personalization_fields": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/personalization"
      }
    },
    "hook_patterns": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/hook"
      }
    },
    "style_variants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "concept_fit_calibration": {
      "type": "object",
      "required": [
        "go_score",
        "refine_score",
        "rework_score",
        "replace_score",
        "high_fit_signals",
        "weak_fit_signals"
      ],
      "properties": {
        "go_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "refine_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "rework_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "replace_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "high_fit_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "weak_fit_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "ip_safety": {
      "type": "object",
      "required": [
        "niche_specific_avoid",
        "safe_substitutions",
        "human_review_triggers"
      ],
      "properties": {
        "niche_specific_avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safe_substitutions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "risky",
              "replace_with"
            ],
            "properties": {
              "risky": {
                "type": "string",
                "minLength": 1
              },
              "replace_with": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "human_review_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "output_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outputProfile"
      }
    },
    "output_defaults": {
      "type": "object",
      "required": [
        "background",
        "product_contrast",
        "variant_count_default",
        "variant_count_min",
        "variant_count_max",
        "copy_mode_default"
      ],
      "properties": {
        "background": {
          "type": "object",
          "required": [
            "preferred_mode",
            "transparent_format",
            "require_real_alpha",
            "capability_policy",
            "supported_model_route",
            "unknown_model_route",
            "unsupported_model_route",
            "max_transparent_attempts",
            "unknown_probe_attempts",
            "fallback_condition",
            "require_native_transparency_option_when_available",
            "hard_fail_supported_after_attempts",
            "final_output_must_have_alpha",
            "fallback_enabled",
            "safe_palette",
            "selection_method",
            "mandatory_prompt",
            "forbidden"
          ],
          "properties": {
            "preferred_mode": {
              "const": "transparent"
            },
            "transparent_format": {
              "const": "PNG"
            },
            "require_real_alpha": {
              "const": true
            },
            "fallback_enabled": {
              "const": true
            },
            "safe_palette": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/hexColor"
              }
            },
            "selection_method": {
              "const": "max-color-distance-from-artwork"
            },
            "mandatory_prompt": {
              "type": "string",
              "minLength": 1
            },
            "forbidden": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "capability_policy": {
              "const": "capability-gated"
            },
            "supported_model_route": {
              "const": "transparent-required-no-fallback"
            },
            "unknown_model_route": {
              "const": "probe-then-fallback"
            },
            "unsupported_model_route": {
              "const": "flat-solid-remove-to-alpha"
            },
            "max_transparent_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "unknown_probe_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "fallback_condition": {
              "const": "confirmed-transparent-unavailable-only"
            },
            "require_native_transparency_option_when_available": {
              "const": true
            },
            "hard_fail_supported_after_attempts": {
              "const": true
            },
            "final_output_must_have_alpha": {
              "const": true
            }
          },
          "additionalProperties": true
        },
        "product_contrast": {
          "type": "object",
          "required": [
            "dark_surface_use",
            "light_surface_use",
            "mid_surface_use",
            "minimum_contrast_ratio",
            "unknown_surface_action"
          ],
          "properties": {
            "dark_surface_use": {
              "const": "light"
            },
            "light_surface_use": {
              "const": "dark"
            },
            "mid_surface_use": {
              "const": "high-contrast-dual-tone"
            },
            "minimum_contrast_ratio": {
              "type": "number",
              "minimum": 3,
              "maximum": 21
            },
            "unknown_surface_action": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "variant_count_default": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "variant_count_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "variant_count_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "copy_mode_default": {
          "enum": [
            "exact",
            "proposed",
            "none"
          ]
        }
      },
      "additionalProperties": true
    },
    "qa_rules": {
      "type": "object",
      "required": [
        "max_colors",
        "min_text_legibility",
        "copy_modes",
        "alpha_validation_required",
        "rerender_on_alpha_failure",
        "fallback_on_supported_alpha_failure",
        "minimum_fully_transparent_ratio",
        "minimum_transparent_border_ratio",
        "minimum_visible_ratio",
        "maximum_significant_visible_ratio",
        "maximum_significant_bbox_fill_ratio",
        "minimum_significant_margin_ratio",
        "significant_alpha_threshold",
        "isolated_artwork",
        "no_shadows",
        "product_contrast_required",
        "minimum_contrast_ratio",
        "background_edge_rule"
      ],
      "properties": {
        "max_colors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "min_text_legibility": {
          "type": "string",
          "minLength": 1
        },
        "copy_modes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "exact",
              "proposed",
              "none"
            ]
          }
        },
        "alpha_validation_required": {
          "const": true
        },
        "isolated_artwork": {
          "const": true
        },
        "no_shadows": {
          "const": true
        },
        "product_contrast_required": {
          "const": true
        },
        "minimum_contrast_ratio": {
          "type": "number",
          "minimum": 3,
          "maximum": 21
        },
        "background_edge_rule": {
          "type": "string",
          "minLength": 1
        },
        "rerender_on_alpha_failure": {
          "const": true
        },
        "fallback_on_supported_alpha_failure": {
          "const": false
        },
        "minimum_fully_transparent_ratio": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.95
        },
        "minimum_transparent_border_ratio": {
          "type": "number",
          "minimum": 0.9,
          "maximum": 1.0
        },
        "minimum_visible_ratio": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 0.25
        },
        "maximum_significant_visible_ratio": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 0.99
        },
        "maximum_significant_bbox_fill_ratio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.99
        },
        "minimum_significant_margin_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 0.25
        },
        "significant_alpha_threshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 254
        }
      },
      "additionalProperties": true
    },
    "sample_briefs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/brief"
      }
    },
    "market_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/marketContext"
      }
    },
    "evidence_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceClaim"
      }
    },
    "production_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/productionMethod"
      }
    },
    "idea_archetypes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/ideaArchetype"
      }
    },
    "creative_controls": {
      "$ref": "#/$defs/creativeControls"
    },
    "combination_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/combinationRule"
      }
    },
    "sensitivity_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sensitivityRule"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "type",
        "note"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "supports": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "persona": {
      "type": "object",
      "required": [
        "id",
        "name",
        "identity_stage",
        "buyer_intents",
        "recipient_relationships",
        "emotional_triggers",
        "insider_language",
        "safe_visual_cues",
        "product_fit",
        "avoid"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identity_stage": {
          "type": "string",
          "minLength": 1
        },
        "buyer_intents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recipient_relationships": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "emotional_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "insider_language": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safe_visual_cues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "product_fit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "pair": {
      "type": "object",
      "required": [
        "id",
        "buyer",
        "recipient",
        "purchase_reason",
        "strong_occasions",
        "preferred_products"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "buyer": {
          "type": "string",
          "minLength": 1
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "purchase_reason": {
          "type": "string",
          "minLength": 1
        },
        "strong_occasions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preferred_products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "occasion": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "seasonality",
        "lead_time_days",
        "strong_angles",
        "common_products",
        "personalization",
        "avoid"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "seasonality": {
          "type": "string",
          "minLength": 1
        },
        "lead_time_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "strong_angles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "common_products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "personalization": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "emotion": {
      "type": "object",
      "required": [
        "id",
        "name",
        "job_to_be_done",
        "use_when",
        "design_direction",
        "copy_tone",
        "avoid"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "job_to_be_done": {
          "type": "string",
          "minLength": 1
        },
        "use_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "design_direction": {
          "type": "string",
          "minLength": 1
        },
        "copy_tone": {
          "type": "string",
          "minLength": 1
        },
        "avoid": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "buyerLanguage": {
      "type": "object",
      "required": [
        "theme",
        "phrases",
        "meaning",
        "use_for",
        "avoid"
      ],
      "properties": {
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "use_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "motif": {
      "type": "object",
      "required": [
        "name",
        "meaning",
        "use_with",
        "avoid_with"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "use_with": {
          "type": "array",
