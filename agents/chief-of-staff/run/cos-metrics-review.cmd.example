:: Replace the root token and verify executable paths before scheduling.
:: Configure narrowly scoped noninteractive tool permissions yourself; never auto-bypass.
@echo off
cd /d "«COS_ROOT»"
node "«COS_ROOT»\scripts\run-routine.mjs" cos-metrics-review --root "«COS_ROOT»" -- "%USERPROFILE%\.local\bin\claude.exe" -p "Read «COS_ROOT»/routines/cos-metrics-review/SKILL.md and follow it." --permission-mode acceptEdits --output-format json < nul > nul
exit /b %errorlevel%
