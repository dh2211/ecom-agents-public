:: Replace the root token and verify executable paths before scheduling.
:: Configure narrowly scoped noninteractive tool permissions yourself; never auto-bypass.
@echo off
cd /d "«GTM_ROOT»"
node "«GTM_ROOT»\scripts\run-routine.mjs" gtm-launch-step-runner --root "«GTM_ROOT»" -- "%USERPROFILE%\.local\bin\claude.exe" -p "Read «GTM_ROOT»/routines/gtm-launch-step-runner/SKILL.md and follow it." --permission-mode acceptEdits --output-format json < nul > nul
exit /b %errorlevel%
