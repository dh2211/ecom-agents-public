:: Replace the root token and verify executable paths before scheduling.
:: Configure narrowly scoped noninteractive tool permissions yourself; never auto-bypass.
@echo off
cd /d "«CSAT_ROOT»"
node "«CSAT_ROOT»\scripts\run-routine.mjs" csat-desk-standup --root "«CSAT_ROOT»" -- "%USERPROFILE%\.local\bin\claude.exe" -p "Read «CSAT_ROOT»/routines/csat-desk-standup/SKILL.md and follow it." --permission-mode acceptEdits --output-format json < nul > nul
exit /b %errorlevel%
