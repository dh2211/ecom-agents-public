:: Replace the root token and verify executable paths before scheduling.
:: Configure narrowly scoped noninteractive tool permissions yourself; never auto-bypass.
@echo off
cd /d "«SEO_ROOT»"
node "«SEO_ROOT»\scripts\run-routine.mjs" seo-rank-review --root "«SEO_ROOT»" -- "%USERPROFILE%\.local\bin\claude.exe" -p "Read «SEO_ROOT»/routines/seo-rank-review/SKILL.md and follow it." --permission-mode acceptEdits --output-format json < nul > nul
exit /b %errorlevel%
