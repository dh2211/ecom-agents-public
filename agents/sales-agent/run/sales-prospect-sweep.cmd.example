:: Replace the root token and verify executable paths before scheduling.
:: Configure narrowly scoped noninteractive tool permissions yourself; never auto-bypass.
@echo off
cd /d "«SALES_ROOT»"
node "«SALES_ROOT»\scripts\run-routine.mjs" sales-prospect-sweep --root "«SALES_ROOT»" -- "%USERPROFILE%\.local\bin\claude.exe" -p "Read «SALES_ROOT»/routines/sales-prospect-sweep/SKILL.md and follow it." --permission-mode acceptEdits --output-format json < nul > nul
exit /b %errorlevel%
