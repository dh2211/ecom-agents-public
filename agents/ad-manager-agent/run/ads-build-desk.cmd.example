:: Replace the root token and verify executable paths before scheduling.
:: Configure narrowly scoped noninteractive tool permissions yourself; never auto-bypass.
@echo off
cd /d "«ADS_ROOT»"
node "«ADS_ROOT»\scripts\run-routine.mjs" ads-build-desk --root "«ADS_ROOT»" -- "%USERPROFILE%\.local\bin\claude.exe" -p "Read «ADS_ROOT»/routines/ads-build-desk/SKILL.md and follow it." --permission-mode acceptEdits --output-format json < nul > nul
exit /b %errorlevel%
