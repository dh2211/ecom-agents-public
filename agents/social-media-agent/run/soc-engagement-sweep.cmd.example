:: Replace the root token and verify executable paths before scheduling.
:: Configure narrowly scoped noninteractive tool permissions yourself; never auto-bypass.
@echo off
cd /d "«SOC_ROOT»"
node "«SOC_ROOT»\scripts\run-routine.mjs" soc-engagement-sweep --root "«SOC_ROOT»" -- "%USERPROFILE%\.local\bin\claude.exe" -p "Read «SOC_ROOT»/routines/soc-engagement-sweep/SKILL.md and follow it." --permission-mode acceptEdits --output-format json < nul > nul
exit /b %errorlevel%
