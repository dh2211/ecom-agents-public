# Working state an installed agent writes. It never belongs in a repo, and a fork that
# pushes its working folder must never publish its leads, drafts, ledgers or strategy.
# Every pattern is anchored to the kit root, so the fictional files under agents/*/examples/ stay tracked.
agents/*/archive/
agents/*/board/
agents/*/briefs/
agents/*/build/
agents/*/calendar/
agents/*/changes/
agents/*/charter/
agents/*/creative/
