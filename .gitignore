agents/*/deps/
agents/*/desk/
agents/*/dossiers/
agents/*/engagement/
agents/*/evidence/
agents/*/fleet/
agents/*/health/
agents/*/help/
agents/*/improvements/
agents/*/inventory/
agents/*/macros/
agents/*/market/
agents/*/material/
agents/*/metrics/
agents/*/paid/
agents/*/pipeline/
agents/*/plan/
agents/*/platform/
agents/*/policy/
agents/*/posts/
agents/*/queue/
agents/*/report/
agents/*/reports/
agents/*/review/
agents/*/risk/
agents/*/scoreboard/
agents/*/scorecard/
agents/*/state/
agents/*/strategy/
agents/*/tickets/
agents/*/voice/
agents/*/run/*
!agents/*/run/*.cmd.example
agents/*/runlog.jsonl
